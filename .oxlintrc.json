{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn",
        "nursery": "warn"
    },
    "rules": {
        "no-underscore-dangle": ["warn", { "allow": ["__typename"] }]
    },
    "env": {
        "builtin": true
    },
    "options": {
        "typeAware": true,
        "typeCheck": true
    }
}
