{
    "name": "churrros",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev --host",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo 'svelte-kit sync skipped'; lefthook install || echo 'lefthook skipped'",
        "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "oxlint",
        "format": "oxfmt",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
    },
    "dependencies": {
        "@lucide/svelte": "^1.61.0",
        "@tanstack/svelte-query": "^6.3.5",
        "azucar-ui": "^0.0.15",
        "gql.tada": "^1.11.4",
        "svelte-sonner": "^1.2.1"
    },
    "devDependencies": {
        "@gql.tada/svelte-support": "^1.0.3",
        "@inlang/paraglide-js": "^2.29.1",
        "@sveltejs/adapter-node": "^6.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "arktype": "^2.2.9",
        "graphql": "^17.0.2",
        "lefthook": "^2.2.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "qrcode": "^1.5.4",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "typescript": "^6.0.3",
        "vite": "^8.3.5"
    }
}
