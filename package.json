{
    "name": "churrros",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
    },
    "devDependencies": {
        "@inlang/paraglide-js": "^2.18.2",
        "@sveltejs/adapter-auto": "^7.0.1",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^26.1.2",
        "graphql": "^17.0.2",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@lucide/svelte": "^1.0.1",
        "@tanstack/svelte-query": "^6.1.36",
        "azucar-ui": "^0.0.11",
        "cookie": "^2.0.1",
        "gql.tada": "^1.11.2"
    },
    "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
